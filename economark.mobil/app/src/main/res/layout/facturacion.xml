<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollFactura"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutFactura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧾 COMPROBANTE DE VENTA"
            android:textStyle="bold"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:gravity="center"/>

        <!-- Número de venta -->
        <TextView
            android:id="@+id/tvNumeroVenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Venta #123"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <!-- Fecha -->
        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025-04-23"
            android:fontFamily="monospace"
            android:textSize="14sp"/>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCC"
            android:layout_marginVertical="8dp" />

        <!-- Lista de productos -->
        <LinearLayout
            android:id="@+id/layoutProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCC"
            android:layout_marginVertical="8dp" />

        <!-- Total -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: $0.00"
            android:textStyle="bold"
            android:gravity="end"
            android:textSize="16sp"
            android:fontFamily="monospace"/>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCC"
            android:layout_marginVertical="8dp" />

        <!-- Mensaje -->
        <TextView
            android:id="@+id/tvGracias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Gracias por su compra! 💜"
            android:fontFamily="monospace"
            android:textColor="#999999"
            android:textSize="12sp"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
